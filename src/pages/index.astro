---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero/Hero.astro';
import Productos from '../components/Productos/Productos.astro';
import Convertir from '../components/Convertir/Convertir.astro';
import Demo from '../components/Demo/Demo.astro';
import CTA from '../components/CTA/CTA.astro';
import Company from '../components/Company/Company.astro';
import Contacto from '../components/Contacto/Contacto';

// SEO details
const title = "JookERP - Control Total de tus finanzas y operaciones";
const description = "Optimiza tu facturación, gestiona cuentas por pagar y controla tu inventario con JookERP. La plataforma integral para el crecimiento de tu negocio.";
---

<Layout title={title} description={description}>
	<Hero />
	
	<Productos />
	
	<Convertir />

	<Demo />

	<CTA />
	
	<Company />

	<Contacto client:visible />
</Layout>

<style>
	/* Any page-specific styles if needed */
</style>
