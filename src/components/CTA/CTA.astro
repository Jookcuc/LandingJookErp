---
import figuraFondoBlanco from '../../assets/FIGURAFONDOblanco.png';
import gestionaEquipo from '../../assets/GestionaEquipo.svg';
---

<section id="equipo" class="py-12 md:py-16 bg-white text-[#0D071D] relative overflow-hidden min-h-screen flex items-center reveal-section-equipo">
  {/* Background FiguraFondo Blanco 1 - Left */}
  <div class="absolute inset-0 z-0 opacity-100 pointer-events-none">
    <img 
      src={figuraFondoBlanco.src} 
      class="absolute top-[40%] left-[-8%] -translate-y-1/2 w-[1000px] max-w-none opacity-20 mix-blend-multiply transition-transform duration-1000 ease-out" 
      alt="" 
    />
  </div>

  {/* Background FiguraFondo Blanco 2 - Right/Bottom */}
  <div class="absolute inset-0 z-0 opacity-100 pointer-events-none">
    <img 
      src={figuraFondoBlanco.src} 
      class="absolute bottom-[-10%] right-[-10%] w-[1100px] max-w-none opacity-25 mix-blend-multiply transform rotate-180 transition-transform duration-1000 ease-out" 
      alt="" 
    />
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="flex flex-col lg:flex-row items-center gap-8 lg:gap-16">
      
      {/* Illustration Container - Left side */}
      <div class="flex-1 w-full order-2 lg:order-1 opacity-0 -translate-x-12 transition-all duration-[1400ms] cubic-bezier(0.22, 1, 0.36, 1) reveal-image-equipo">
        <div class="relative max-w-md mx-auto lg:mx-0">
          <img 
            src={gestionaEquipo.src} 
            alt="Ilustración Gestión de Equipo" 
            class="w-full h-auto transform transition-transform duration-[2000ms] hover:scale-105" 
          />
        </div>
      </div>

      {/* Text Content - Right side */}
      <div class="flex-1 flex flex-col items-start text-left order-1 lg:order-2 opacity-0 translate-y-12 transition-all duration-[1400ms] cubic-bezier(0.22, 1, 0.36, 1) delay-200 reveal-content-equipo">
         <h2 class="text-4xl md:text-5xl lg:text-5xl font-bold mb-4 leading-tight text-[#0D071D] max-w-xl">
           Gestiona tu equipo con la misma precisión que tus finanzas.
         </h2>
         <div class="w-16 h-1.5 bg-[#2B195D] mb-4 rounded-full"></div>
         <p class="text-lg text-gray-600 mb-6 leading-relaxed font-normal max-w-lg">
           Llevar el control de tu personal no tiene por qué ser un proceso separado. Integra la gestión de empleados y el pago de nómina directamente con tu contabilidad general.
         </p>
         
         <div class="space-y-3 w-full">
            <div class="flex gap-4 items-start group">
               <span class="text-[#0D071D] font-bold text-base min-w-[20px]">1.</span>
               <p class="text-base md:text-lg text-gray-700">
                  <strong class="text-[#0D071D]">Expediente Digital:</strong> 
                  Datos personales, cargos y documentos legales.
               </p>
            </div>
            <div class="flex gap-4 items-start group">
               <span class="text-[#0D071D] font-bold text-base min-w-[20px]">2.</span>
               <p class="text-base md:text-lg text-gray-700">
                  <strong class="text-[#0D071D]">Control de Nómina:</strong> 
                  Pagos de salarios, bonos y deducciones en segundos.
               </p>
            </div>
            <div class="flex gap-4 items-start group">
               <span class="text-[#0D071D] font-bold text-base min-w-[20px]">3.</span>
               <p class="text-base md:text-lg text-gray-700">
                  <strong class="text-[#0D071D]">Comprobantes Automáticos:</strong> 
                  Genera recibos de pago en PDF listos para enviar.
               </p>
            </div>
            <div class="flex gap-4 items-start group">
               <span class="text-[#0D071D] font-bold text-base min-w-[20px]">4.</span>
               <p class="text-base md:text-lg text-gray-700">
                  <strong class="text-[#0D071D]">Sincronización de Egresos:</strong> 
                  Cada pago se refleja automáticamente en tu flujo de caja.
               </p>
            </div>
         </div>
      </div>

    </div>
  </div>
</section>

<script>
  const observerOptions = {
    threshold: 0.2
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const content = entry.target.querySelector('.reveal-content-equipo');
        const image = entry.target.querySelector('.reveal-image-equipo');
        
        if (content) {
          content.classList.remove('opacity-0', 'translate-y-12');
          content.classList.add('opacity-100', 'translate-y-0');
        }
        if (image) {
          image.classList.remove('opacity-0', '-translate-x-12');
          image.classList.add('opacity-100', 'translate-x-0');
        }
      }
    });
  }, observerOptions);

  const section = document.querySelector('.reveal-section-equipo');
  if (section) observer.observe(section);
</script>
