---
import figuraFondo from '../../assets/FiguraFondo.svg';

const steps = [
  {
    title: "Control de Pagos",
    desc: "Gestiona tus Cuentas por Pagar al día. Evita recargos y mantén tus relaciones comerciales sólidas.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-receipt"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 17.5V6.5"/></svg>`
  },
  {
    title: "Conciliaciones",
    desc: "Importa tus movimientos bancarios y realiza cuadres automáticos en cuestión de segundos.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-refresh-cw"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M3 21v-5h5"/></svg>`
  },
  {
    title: "Proyecciones",
    desc: "Define presupuestos reales y visualiza el crecimiento de tu negocio a corto y largo plazo.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trending-up"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><path d="M17 6h6v6"/></svg>`
  }
];
---

<section id="demo" class="py-20 bg-[#0D071D] text-white relative overflow-hidden text-center min-h-screen flex items-center reveal-section-demo">
  {/* Background FiguraFondo */}
  <div class="absolute inset-0 z-0 opacity-30 pointer-events-none">
    <img src={figuraFondo.src} class="absolute top-[50%] left-1/2 -translate-x-1/2 -translate-y-1/2 w-[1600px] brightness-[2] mix-blend-screen" alt="" />
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 flex flex-col items-center w-full">
    <div class="opacity-0 translate-y-8 transition-all duration-[1400ms] cubic-bezier(0.22, 1, 0.36, 1) reveal-header-demo mb-16">
      <h2 class="text-4xl md:text-5xl font-bold mb-4 leading-tight">Da el siguiente paso</h2>
      <div class="w-16 h-1 bg-[#2B195D] mx-auto mb-6 rounded-full"></div>
      <p class="text-lg text-gray-400 max-w-2xl font-normal">
        Herramientas financieras diseñadas para la eficiencia de tu negocio.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 mb-20 w-full">
      {steps.map((step, idx) => (
        <div 
          class="group bg-[#1C0F3C]/40 backdrop-blur-md border border-white/5 rounded-[1.5rem] p-8 text-left transition-all duration-700 hover:bg-[#1C0F3C]/60 hover:border-white/10 shadow-xl opacity-0 translate-y-8 reveal-card-demo"
          style={`transition-delay: ${idx * 150}ms;`}
        >
          <div class="w-14 h-14 bg-white text-[#0D071D] rounded-xl flex items-center justify-center mb-6 transform transition-transform duration-500 group-hover:scale-110 shadow-lg">
            <Fragment set:html={step.icon} />
          </div>
          <h3 class="text-xl font-bold mb-4 text-white">{step.title}</h3>
          <p class="text-gray-400 leading-relaxed font-normal text-base group-hover:text-gray-300 transition-colors">
            {step.desc}
          </p>
        </div>
      ))}
    </div>

    <div class="opacity-0 scale-95 transition-all duration-[1200ms] delay-500 reveal-button-demo mt-0">
      <a href="#contacto" class="bg-white text-[#0D071D] px-12 py-4 rounded-xl text-lg font-bold transition-all hover:bg-gray-100 shadow-xl active:scale-95 inline-block">
        Solicitar acceso
      </a>
    </div>
  </div>
</section>

<script>
  const observerOptions = {
    threshold: 0.1
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const header = entry.target.querySelector('.reveal-header-demo');
        const cards = entry.target.querySelectorAll('.reveal-card-demo');
        const button = entry.target.querySelector('.reveal-button-demo');
        
        if (header) {
          header.classList.remove('opacity-0', 'translate-y-8');
          header.classList.add('opacity-100', 'translate-y-0');
        }
        
        cards.forEach(card => {
          card.classList.remove('opacity-0', 'translate-y-8');
          card.classList.add('opacity-100', 'translate-y-0');
        });

        if (button) {
          button.classList.remove('opacity-0', 'scale-95');
          button.classList.add('opacity-100', 'scale-100');
        }
      }
    });
  }, observerOptions);

  const section = document.querySelector('.reveal-section-demo');
  if (section) observer.observe(section);
</script>
