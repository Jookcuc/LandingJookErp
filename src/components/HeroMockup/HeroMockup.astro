---
---

<div class="relative w-full aspect-[16/10] lg:scale-125 origin-center drop-shadow-[0_20px_60px_rgba(0,0,0,0.5)] font-sans">
  <!-- Rear Window: Transactions Table (Made larger) -->
  <div class="absolute top-0 right-0 w-[95%] h-[85%] bg-white rounded-xl shadow-2xl border border-gray-100 overflow-hidden transform hover:translate-y-[-5px] transition-transform duration-500">
    <div class="bg-white px-6 py-4 border-b border-gray-100 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 bg-blue-500 rounded-lg flex items-center justify-center text-white text-xs font-bold">T</div>
        <div>
          <h3 class="text-sm font-bold text-gray-800 leading-tight">Transacciones</h3>
          <p class="text-[10px] text-gray-400">Historial de transacciones</p>
        </div>
      </div>
      <div class="flex gap-2">
        <div class="w-12 h-4 bg-gray-50 rounded text-[8px] flex items-center justify-center text-gray-300 uppercase font-bold">UT</div>
        <div class="w-12 h-4 bg-gray-50 rounded text-[8px] flex items-center justify-center text-gray-300 uppercase font-bold">CD</div>
      </div>
    </div>
    
    <!-- Stats Row -->
    <div class="grid grid-cols-3 gap-3 p-4 bg-gray-50/50">
      <div class="bg-[#10B981] p-3 rounded-lg text-white shadow-sm">
        <p class="text-[8px] opacity-80 mb-1 font-bold">Ingresos</p>
        <p class="text-sm font-extrabold tracking-tight">1862,85$</p>
      </div>
      <div class="bg-[#EF4444] p-3 rounded-lg text-white shadow-sm">
        <p class="text-[8px] opacity-80 mb-1 font-bold">Egresos</p>
        <p class="text-sm font-extrabold tracking-tight">4185,06$</p>
      </div>
      <div class="bg-[#2563EB] p-3 rounded-lg text-white shadow-sm">
        <p class="text-[8px] opacity-80 mb-1 font-bold">Balance total</p>
        <p class="text-sm font-extrabold tracking-tight">-2322,20$</p>
      </div>
    </div>

    <!-- Mini Table Header -->
    <div class="px-6 py-2 border-b border-gray-50 grid grid-cols-6 gap-2 text-[7px] font-black text-gray-400 uppercase tracking-tighter">
      <span>Referencia</span>
      <span>Categoría</span>
      <span>Estado</span>
      <span>Monto</span>
      <span>Método</span>
      <span>Fecha</span>
    </div>
    <!-- Mini Table Rows -->
    <div class="px-6 py-4 space-y-4">
       {[1,2,3,4,5].map((i) => (
         <div class="grid grid-cols-6 gap-2 items-center opacity-40">
            <div class="w-full h-1.5 bg-gray-100 rounded"></div>
            <div class="w-full h-1.5 bg-gray-50 rounded"></div>
            <div class="w-full h-3 bg-green-50 rounded-full border border-green-100/50"></div>
            <div class="w-full h-1.5 bg-gray-100 rounded"></div>
            <div class="w-full h-1.5 bg-gray-50 rounded"></div>
            <div class="w-full h-1.5 bg-gray-100 rounded"></div>
         </div>
       ))}
    </div>
  </div>

  <!-- Front Window: Pie Chart (Smaller and positioned better) -->
  <div class="absolute bottom-[-10%] left-[-5%] w-[85%] sm:w-[65%] md:w-[55%] h-[auto] min-h-[60%] md:h-[60%] bg-white rounded-2xl shadow-[0_30px_60px_-15px_rgba(0,0,0,0.4)] border border-gray-100 p-4 sm:p-6 flex flex-col transform hover:translate-x-2 transition-transform duration-500 z-20">
    <h3 class="text-xs sm:text-sm font-bold text-gray-800 mb-4 sm:mb-6">Distribución del periodo</h3>
    
    <div class="flex-1 flex items-center justify-between gap-2 sm:gap-4">
      <!-- Donut Chart (Scaled down) -->
      <div class="relative w-16 h-16 sm:w-24 sm:h-24 flex-shrink-0">
        <svg viewBox="0 0 100 100" class="rotate-[-90deg] w-full h-full">
          <circle cx="50" cy="50" r="40" stroke="#F3F4F6" stroke-width="14" fill="none" />
          <circle cx="50" cy="50" r="40" stroke="#7C3AED" stroke-width="14" fill="none" stroke-dasharray="195 251" />
          <circle cx="50" cy="50" r="40" stroke="#10B981" stroke-width="14" fill="none" stroke-dasharray="40 251" stroke-dashoffset="-195" />
          <circle cx="50" cy="50" r="40" stroke="#6366F1" stroke-width="14" fill="none" stroke-dasharray="16 251" stroke-dashoffset="-235" />
        </svg>
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="w-8 h-8 sm:w-12 sm:h-12 bg-white rounded-full"></div>
        </div>
      </div>

      <!-- Legend (Compact) -->
      <div class="flex-1 space-y-2">
        {[
          { color: 'bg-[#7C3AED]', label: 'PENDIENTE', val: '77.8%' },
          { color: 'bg-[#6366F1]', label: 'PAGADA', val: '11.1%' },
          { color: 'bg-[#10B981]', label: 'VENCIDA', val: '11.1%' },
          { color: 'bg-[#FBBF24]', label: 'ANULADA', val: '0.0%' }
        ].map(item => (
          <div class="flex items-center justify-between border-b border-gray-50 pb-1">
            <div class="flex items-center gap-2">
              <div class={`w-1.5 h-1.5 rounded-full ${item.color}`}></div>
              <span class="text-[7px] font-bold text-gray-400 tracking-tighter uppercase">{item.label}</span>
            </div>
            <span class="text-[8px] font-extrabold text-gray-700">{item.val}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Decorative blur background behind the modules -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full bg-blue-500/5 blur-[120px] -z-10 rounded-full"></div>
</div>
