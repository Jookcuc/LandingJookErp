---
import figuraFondoBlanco from '../../assets/FIGURAFONDOblanco.png';
import figuraProductos from '../../assets/FiguraProductos.svg';
---

<section id="productos" class="py-24 md:py-32 bg-white text-[#0D071D] relative overflow-hidden min-h-screen flex items-center reveal-section">
  {/* Background FiguraFondo Blanco - Aligned to the left */}
  <div class="absolute inset-0 z-0 opacity-100 pointer-events-none">
    <img 
      src={figuraFondoBlanco.src} 
      class="absolute top-[40%] left-0 -translate-y-1/2 w-[1600px] max-w-none opacity-40 mix-blend-multiply" 
      style="transform: translateY(-50%) translateX(-15%);"
      alt="" 
    />
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="flex flex-col lg:flex-row items-center gap-16 lg:gap-24">
      
      {/* Text Content - Left side */}
      <div class="flex-1 flex flex-col items-start text-left opacity-0 translate-y-12 transition-all duration-[1400ms] cubic-bezier(0.22, 1, 0.36, 1) reveal-content">
         <h2 class="text-5xl md:text-6xl font-bold mb-10 leading-tight text-[#0D071D]">
           Registra tus productos <br /><span class="text-[#2B195D]">con facilidad.</span>
         </h2>
         <div class="w-20 h-1.5 bg-[#2B195D] mb-10 rounded-full"></div>
         <p class="text-xl text-gray-600 mb-12 leading-relaxed font-normal max-w-lg">
           Gestiona tu inventario de manera profesional. Desde la carga inicial hasta el control de stock en tiempo real, JookERP simplifica cada paso de tu operación comercial.
         </p>
         
         <ul class="space-y-6 mb-10 text-lg font-bold text-[#0D071D] list-disc list-inside">
           <li>Carga masiva de productos mediante Excel.</li>
           <li>Categorización avanzada por departamentos.</li>
           <li>Alertas de bajo stock automatizadas.</li>
           <li>Historial completo de movimientos de bodega.</li>
         </ul>
      </div>

      {/* Image Container - Right side - Framed and Larger */}
      <div class="flex-1 w-full opacity-0 translate-x-12 transition-all duration-[1400ms] cubic-bezier(0.22, 1, 0.36, 1) delay-200 reveal-image">
        <div class="relative">
          {/* Framed Mockup with Premium shadow */}
          <div class="bg-[#0D071D] rounded-[2.5rem] p-3 md:p-6 shadow-[0_50px_100px_-20px_rgba(13,7,29,0.3)] overflow-hidden transform transition-all duration-[1200ms] hover:scale-[1.01]">
             <div class="overflow-hidden rounded-[1.8rem]">
                <img 
                  src={figuraProductos.src} 
                  alt="Dashboard de Productos JookERP" 
                  class="w-full h-auto object-cover scale-105 hover:scale-100 transition-transform duration-[2000ms]" 
                />
             </div>
          </div>
          {/* Decorative Elements */}
          <div class="absolute -top-10 -right-10 w-40 h-40 bg-[#2B195D]/10 blur-3xl rounded-full"></div>
          <div class="absolute -bottom-10 -left-10 w-40 h-40 bg-[#0D071D]/5 blur-2xl rounded-full"></div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const observerOptions = {
    threshold: 0.2
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const content = entry.target.querySelector('.reveal-content');
        const image = entry.target.querySelector('.reveal-image');
        
        if (content) {
          content.classList.remove('opacity-0', 'translate-y-12');
          content.classList.add('opacity-100', 'translate-y-0');
        }
        if (image) {
          image.classList.remove('opacity-0', 'translate-x-12');
          image.classList.add('opacity-100', 'translate-x-0');
        }
      }
    });
  }, observerOptions);

  const section = document.querySelector('.reveal-section');
  if (section) observer.observe(section);
</script>
